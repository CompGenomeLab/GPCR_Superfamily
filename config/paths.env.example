# Copy this file to paths.env. The default archive is the zenodo_data directory
# beside GPCR_Superfamily; set this only when the archive is somewhere else.
export GPCR_ZENODO_DIR="/path/to/unpacked/zenodo_data"
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/paths.sh"

# Source UniProtKB-derived databases used by the search and family workflows.
export UNIPROT_FASTA="/path/to/Uniprot_Ref_Eukaryota_Proteome.fasta"
export UNIPROT_MMSEQS_DB="/path/to/UniprotRefEuk"

# Used by superfamily_alignment/precompute-mappings.mjs.
export GPCR_WEBSITE_DIR="/path/to/gpcrevolution-website"
